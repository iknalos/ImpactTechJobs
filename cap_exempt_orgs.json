{
 "_about": "Maps dashboard org names to the legal employers in DOL prevailing-wage data (data/acwia_employers.json). Patterns are case-insensitive regexes matched against the DOL legal name, aliases and DBA. 'system': the brand covers several legal employers and only some are ACWIA-covered, so the exemption depends on which entity hires. Orgs whose name matches a DOL employer exactly need no entry.",
 "Harvard University": {"match": ["^PRESIDENT AND FELLOWS OF HARVARD COLLEGE"]},
 "MIT (CSAIL)": {"match": ["^MASSACHUSETTS INSTITUTE OF TECHNOLOGY"]},
 "Tufts University": {"match": ["^TRUSTEES OF TUFTS COLLEGE", "^TUFTS UNIVERSITY"]},
 "UMass Chan Medical School": {"match": ["^UNIVERSITY OF MASSACHUSETTS (CHAN )?MEDICAL SCHOOL", "^UMASS CHAN"]},
 "UMass Boston": {"match": ["^UNIVERSITY OF MASSACHUSETTS,? BOSTON"]},
 "Northeastern University": {"match": ["^NORTHEASTERN UNIVERSITY"]},
 "Brandeis University": {"match": ["^BRANDEIS UNIVERSITY"]},
 "Mass General Brigham": {"system": true, "match": ["^THE GENERAL HOSPITAL CORP", "^GENERAL HOSPITAL CORP", "BRIGHAM AND WOMEN", "^MASS GENERAL BRIGHAM", "^MCLEAN HOSPITAL", "MASSACHUSETTS EYE AND EAR", "^SPAULDING REHAB"]},
 "Beth Israel Lahey Health": {"system": true, "match": ["^BETH ISRAEL DEACONESS MEDICAL CENTER", "^BETH ISRAEL LAHEY", "^LAHEY CLINIC", "^JOSLIN DIABETES"]},
 "Dana-Farber Cancer Institute": {"match": ["^DANA[- ]FARBER CANCER INSTITUTE"]},
 "Boston Medical Center": {"match": ["^BOSTON MEDICAL CENTER"]},
 "Tufts Medicine": {"system": true, "match": ["^TUFTS MEDICAL CENTER", "^NEW ENGLAND MEDICAL CENTER HOSPITALS", "^TUFTS MEDICINE"]},
 "NeighborHealth (EBNHC)": {"match": ["^EAST BOSTON NEIGHBORHOOD HEALTH CENTER", "^NEIGHBORHEALTH"]},
 "Boston Children's Hospital": {"match": ["^(THE )?CHILDREN'?S HOSPITAL CORPORATION", "^BOSTON CHILDREN'?S HOSPITAL"]},
 "RAND": {"match": ["^(THE )?RAND CORPORATION"]},
 "Urban Institute": {"match": ["^(THE )?URBAN INSTITUTE"]},
 "American Institutes for Research": {"match": ["^AMERICAN INSTITUTES FOR RESEARCH"]},
 "NORC at the University of Chicago": {"match": ["^NORC"]},
 "ALSAC / St. Jude": {"system": true, "match": ["^ST\\.? JUDE CHILDREN'?S RESEARCH HOSPITAL", "^ALSAC"]},
 "American Cancer Society": {"match": ["^AMERICAN CANCER SOCIETY"]},
 "Hebrew SeniorLife": {"match": ["^HEBREW REHABILITATION CENTER", "^HEBREW SENIORLIFE"]}
}
